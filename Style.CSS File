body{
    text-align: center;
    font-family: Arial, sans-serif;
}

.gallery{
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 15px;
    padding: 20px;
}

.gallery img{
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 10px;
    transition: 0.3s;
}

.gallery img:hover{
    transform: scale(1.1);
}
@media(max-width:768px){
    .gallery{
        grid-template-columns: repeat(2,1fr);
    }
}

@media(max-width:480px){
    .gallery{
        grid-template-columns: 1fr;
    }
}
